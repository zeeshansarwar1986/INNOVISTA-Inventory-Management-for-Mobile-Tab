{
  "name": "innovista-inventory",
  "version": "1.0.0",
  "description": "INNOVISTA Inventory Management by Zeeshan Sarwar",
  "private": true,
  "scripts": {
    "vendor": "node -e \"require('fs').mkdirSync('www/vendor',{recursive:true});require('fs').copyFileSync('node_modules/xlsx/dist/xlsx.full.min.js','www/vendor/xlsx.full.min.js')\"",
    "serve": "npx http-server www -p 8080 -c-1",
    "android:add": "npx cap add android",
    "android:sync": "npm run vendor && npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "build": "node tools/protect.js www dist",
    "license:key": "node tools/set-public-key.js"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/cli": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "xlsx": "0.18.5",
    "@capacitor-community/sqlite": "^6.0.2",
    "@capacitor/device": "^6.0.0"
  },
  "devDependencies": {
    "javascript-obfuscator": "^4.1.0"
  }
}